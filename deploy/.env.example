# Copy to deploy/.env and fill in real values. deploy/.env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flash_sale
POSTGRES_USER=flash_sale
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_API=5
POSTGRES_POOL_WORKER=10

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRES_IN=1h

# --- API ---
API_PORT=3000
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=220

# --- Worker ---
WORKER_CONCURRENCY=15

# --- Nginx ---
NGINX_PORT=80
