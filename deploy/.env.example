# Copy to deploy/.env and fill in real values. deploy/.env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flash_sale
POSTGRES_USER=flash_sale
POSTGRES_PASSWORD=changeme
# API rarely touches Postgres (cache-served reads, Redis-only order claim).
POSTGRES_POOL_API=8
# Keep >= WORKER_CONCURRENCY or the write drain waits on connections.
POSTGRES_POOL_WORKER=20

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRES_IN=1h

# --- API ---
API_PORT=3000
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=220

# --- Worker ---
WORKER_CONCURRENCY=15
WORKER_PORT=3001

# --- Nginx ---
NGINX_PORT=80
