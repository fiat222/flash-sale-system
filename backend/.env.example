# For local `npm run start:dev` outside docker compose. Copy to backend/.env.
ROLE=api

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flash_sale
POSTGRES_USER=flash_sale
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_API=5
POSTGRES_POOL_WORKER=10

