{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["jest"]
  },
  "watchOptions": {
    // Docker Desktop on Windows/Mac doesn't forward host filesystem events
    // into the container's inotify across a bind mount — native watching
    // silently never fires. Polling is the only reliable option here.
    "watchFile": "fixedPollingInterval",
    "watchDirectory": "fixedPollingInterval"
  }
}
